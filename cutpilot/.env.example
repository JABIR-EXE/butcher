# Local preview (default)
CUTPILOT_MODE=local
CUTPILOT_HOST=127.0.0.1
CUTPILOT_PORT=8765

# Hosted pilot (set privately in hosting provider)
# CUTPILOT_MODE=saas
# CUTPILOT_HOST=0.0.0.0
# CUTPILOT_DATA_DIR=/var/data/cutpilot
# CUTPILOT_BASE_URL=https://app.example.com
# CUTPILOT_COOKIE_SECURE=1
# CUTPILOT_REQUIRE_EMAIL_VERIFICATION=1
# CUTPILOT_SESSION_DAYS=7
# CUTPILOT_SMTP_HOST=smtp.example.com
# CUTPILOT_SMTP_PORT=587
# CUTPILOT_SMTP_USER=your-smtp-user
# CUTPILOT_SMTP_PASSWORD=your-smtp-password
# CUTPILOT_EMAIL_FROM=CutPilot <noreply@example.com>

# Billing is intentionally not configured in v1.8.
